# URL: only the address, without mqtts:// (example: abc123.s1.eu.hivemq.cloud)
HIVEMQ_BROKER_URL=

# PORT: 8883 for secure MQTT
HIVEMQ_PORT=8883

# Login details from the HiveMQ dashboard
# (send these privately, do not commit them here)
HIVEMQ_USERNAME=
HIVEMQ_PASSWORD=
